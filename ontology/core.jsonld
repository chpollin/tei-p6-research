      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en",
          "@value": "Documents how a subject reference is read: record for the handle, referent for the described object, concept for a vocabulary value, or proposition for recorded content. An unfamiliar predicate has no licensed interpretation."
