# Normalize repository text to LF on every platform. Git still detects binary
# files automatically and leaves their byte content unchanged.
* text=auto eol=lf

# Admitted originals are byte-faithful source artifacts. Do not normalize them.
00_sources/** -text
00_sources/README.md text eol=lf

# Preserve source-faithful whitespace in immutable ingested representations.
10_markdown/documents/tei-p5-*-4.12.0.md -text -whitespace
10_markdown/documents/tei-time-for-p6-readme-2026-07-16.md -whitespace
10_markdown/documents/tei-p5-anchor-4.12.0.md -whitespace
10_markdown/documents/tei-p5-span-4.12.0.md -whitespace
10_markdown/documents/tei-p5-annotation-4.12.0.md -whitespace
10_markdown/documents/humboldt-h0017682-7d174637.md -whitespace
10_markdown/documents/szd-werke-2026-09-07.md -text -whitespace
10_markdown/documents/hsa-letter-4493-2026-09-07.md -text -whitespace

# Reconstructed HSA originals keep their admitted bytes and whitespace.
experiments/hsa_letter_4493/p5.xml -text -whitespace
