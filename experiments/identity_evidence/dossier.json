      {
        "content": "<biblFull ana=\"02_Rausch\" xml:id=\"SZDMSK.4\">\n          <fileDesc>\n            <titleStmt>\n              <title ana=\"supplied/verified\" ref=\"http://d-nb.info/gnd/7756961-1\">Rausch der Verwandlung</title>\n              <title type=\"Einheitssachtitel\">Rausch der Verwandlung</title>\n              <title type=\"Gesamttitel\">Stefan Zweig - Archiv Atrium Press</title>\n              <author ref=\"#SZDPER.1560\">\n                <persName ref=\"http://d-nb.info/gnd/118637479\">\n                  <surname>Zweig</surname>\n                  <forename>Stefan</forename>\n                </persName>\n              </author>\n            </titleStmt>\n            <publicationStmt>\n              <ab>Archivmaterial</ab>\n            </publicationStmt>\n            <notesStmt>\n              <note xml:lang=\"de\">1 Blatt mit Anmerkungen in Bleistift auf der\n                                Rückseite, Seite 117 doppelt</note>\n              <note xml:lang=\"en\">1 leaf has pencil annotations on verso, page 117 in\n                                duplicate</note>\n            </notesStmt>\n            <sourceDesc>\n              <msDesc>\n                <msIdentifier>\n                  <country>Österreich</country>\n                  <settlement>Salzburg</settlement>\n                  <repository ref=\"http://d-nb.info/gnd/1047605287\">Literaturarchiv Salzburg</repository>\n                  <idno type=\"signature\">SZ-AAP/W2.2</idno>\n                  <altIdentifier>\n                    <idno type=\"PID\">o:szd.948</idno>\n                  </altIdentifier>\n                </msIdentifier>\n                <msContents>\n                  <textLang>\n                    <lang xml:lang=\"ger\">Deutsch</lang>\n                  </textLang>\n                  <msItem>\n                    <incipit>„Vier Wochen lang erträgt Christine diesen\n                                            grausamen, krankhaft überreizten Zustand gewaltsamer\n                                            Einsamkeit …“</incipit>\n                    <docEdition ana=\"szdg:IdentifyingInscription\" xml:lang=\"de\">„II Teil noch nicht copiert“ eigenhändig</docEdition>\n                    <docEdition ana=\"szdg:IdentifyingInscription\" xml:lang=\"en\">„II Teil noch nicht copiert“ holograph</docEdition>\n                  </msItem>\n                </msContents>\n                <physDesc>\n                  <objectDesc>\n                    <supportDesc>\n                      <support>\n                        <material ana=\"szdg:WritingMaterial\" xml:lang=\"de\">Überwiegend Doppelbögen</material>\n                        <material ana=\"szdg:WritingMaterial\" xml:lang=\"en\">Mainly bifolia</material>\n                        <material ana=\"szdg:WritingInstrument\" xml:lang=\"de\">Violettes Farbband, violette und schwarze Tinte,\n                                                  Bleistift, blauer Kugelschreiber</material>\n                        <material ana=\"szdg:WritingInstrument\" xml:lang=\"en\">Purple ribbon, purple and black ink, pencil, blue\n                                                  ballpoint</material>\n                      </support>\n                      <extent>\n                        <span xml:lang=\"de\">\n                          <term type=\"objecttyp\">Typoskript</term>, <measure ana=\"corrected\" type=\"leaf\">87 Blatt,\n                                                  korrigiert</measure>\n                        </span>\n                        <span xml:lang=\"en\">\n                          <term type=\"objecttyp\">Typescript</term>, <measure ana=\"corrected\" type=\"leaf\">87 leaves,\n                                                  corrected</measure>\n                        </span>\n                        <measure type=\"format\">42x26 cm</measure>\n                      </extent>\n                      <foliation>\n                        <ab xml:lang=\"de\">durchgehend paginiert</ab>\n                        <ab xml:lang=\"en\">paginated throughout</ab>\n                      </foliation>\n                    </supportDesc>\n                  </objectDesc>\n                  <handDesc>\n                    <ab xml:lang=\"de\">Stefan Zweig, fremde Hand</ab>\n                    <ab xml:lang=\"en\">Stefan Zweig, unidentified hand</ab>\n                  </handDesc>\n                </physDesc>\n                <history>\n                  <provenance>\n                    <ab xml:lang=\"de\">Archiv Atrium Press</ab>\n                    <ab xml:lang=\"en\">Atrium Press</ab>\n                  </provenance>\n                  <acquisition>\n                    <ab xml:lang=\"de\">Ankauf Christie&apos;s London\n                                            2014</ab>\n                    <ab xml:lang=\"en\">Acquisition from Christie&apos;s London\n                                            2014</ab>\n                  </acquisition>\n                </history>\n              </msDesc>\n            </sourceDesc>\n          </fileDesc>\n          <profileDesc>\n            <textClass>\n              <keywords>\n                <term type=\"classification\" xml:lang=\"de\">Romane/Erzählungen</term>\n                <term type=\"classification\" xml:lang=\"en\">Novels/Stories</term>\n                <term ref=\"#SZDWRK.2\" type=\"work\">Rausch der Verwandlung</term>\n              </keywords>\n            </textClass>\n          </profileDesc>\n        </biblFull>",
