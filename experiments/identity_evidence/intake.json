          "xml": "<biblFull ana=\"01_Rausch\" xml:id=\"SZDMSK.3\">\n          <fileDesc>\n            <titleStmt>\n              <title ana=\"supplied/verified\" ref=\"http://d-nb.info/gnd/7756961-1\">Rausch der Verwandlung</title>\n              <title type=\"Einheitssachtitel\">Rausch der Verwandlung</title>\n              <title type=\"Gesamttitel\">Stefan Zweig - Archiv Atrium Press</title>\n              <author ref=\"#SZDPER.1560\">\n                <persName ref=\"http://d-nb.info/gnd/118637479\">\n                  <surname>Zweig</surname>\n                  <forename>Stefan</forename>\n                </persName>\n              </author>\n              <editor ref=\"#SZDPER.1555\" role=\"contributor\">\n                <persName ref=\"http://d-nb.info/gnd/116001151\">\n                  <surname>Zweig</surname>\n                  <forename>Lotte</forename>\n                </persName>\n              </editor>\n            </titleStmt>\n            <publicationStmt>\n              <ab>Archivmaterial</ab>\n            </publicationStmt>\n            <sourceDesc>\n              <msDesc>\n                <msIdentifier>\n                  <country>Österreich</country>\n                  <settlement>Salzburg</settlement>\n                  <repository ref=\"http://d-nb.info/gnd/1047605287\">Literaturarchiv Salzburg</repository>\n                  <idno type=\"signature\">SZ-AAP/W2.1</idno>\n                  <altIdentifier>\n                    <idno type=\"PID\">o:szd.268</idno>\n                  </altIdentifier>\n                </msIdentifier>\n                <msContents>\n                  <textLang>\n                    <lang xml:lang=\"ger\">Deutsch</lang>\n                  </textLang>\n                  <msItem>\n                    <incipit>„Ein Dorfpostamt in Oesterreich unterscheidet sich\n                                            wenig vom andern: Wer eines gesehen, …“</incipit>\n                  </msItem>\n                </msContents>\n                <physDesc>\n                  <objectDesc>\n                    <supportDesc>\n                      <support>\n                        <material ana=\"szdg:WritingInstrument\" xml:lang=\"de\">Schwarze Tinte, blauer Buntstift</material>\n                        <material ana=\"szdg:WritingInstrument\" xml:lang=\"en\">Black ink, blue pencil</material>                \n      </support>\n                      <extent>\n                        <span xml:lang=\"de\">\n                          <term type=\"objecttyp\">Typoskriptdurchschlag</term>, <measure ana=\"corrected\" type=\"leaf\">159 Blatt, korrigiert;\n                                                  1 Deckblatt</measure>\n                        </span>\n                        <span xml:lang=\"en\">\n                          <term type=\"objecttyp\">Typescript (carbon\n                                                  copy)</term>, <measure ana=\"corrected\" type=\"leaf\">159 leaves, corrected; 1 cover sheet</measure>\n                        </span>\n                        <measure type=\"format\">34x21 cm</measure>\n                      </extent>\n                    </supportDesc>\n                  </objectDesc>\n                  <handDesc>\n                    <ab xml:lang=\"de\">Lotte Zweig (?)</ab>\n                    <ab xml:lang=\"en\">Lotte Zweig (?)</ab>\n                  </handDesc>\n                  <accMat>\n                    <list>\n                      <item ana=\"szdg:Enclosures\">\n                        <desc xml:lang=\"de\">Deckblatt mit Aufschrift „Roman\n                                                  I Teil“ von Lotte Zweigs Hand in blauem\n                                                  Buntstift</desc>\n                        <desc xml:lang=\"en\">Cover sheet inscribed „Roman I\n                                                  Teil“ in Lotte Zweig&apos;s hand in blue pencil</desc>\n                        <measure type=\"format\">31x19 cm</measure>\n                      </item>\n                    </list>\n                  </accMat>\n                </physDesc>\n                <history>\n                  <provenance>\n                    <ab xml:lang=\"de\">Archiv Atrium Press</ab>\n                    <ab xml:lang=\"en\">Atrium Press</ab>\n                  </provenance>\n                  <acquisition>\n                    <ab xml:lang=\"de\">Ankauf Christie&apos;s London\n                                            2014</ab>\n                    <ab xml:lang=\"en\">Acquisition from Christie&apos;s London\n                                            2014</ab>\n                  </acquisition>\n                </history>\n              </msDesc>\n            </sourceDesc>\n          </fileDesc>\n          <profileDesc>\n            <textClass>\n              <keywords>\n                <term type=\"classification\" xml:lang=\"de\">Romane/Erzählungen</term>\n                <term type=\"classification\" xml:lang=\"en\">Novels/Stories</term>\n                <term ref=\"#SZDWRK.2\" type=\"work\">Rausch der Verwandlung</term>\n              </keywords>\n            </textClass>\n          </profileDesc>\n        </biblFull>"
